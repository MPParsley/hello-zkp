{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hello-zkp.example/schemas/zkp-proof.schema.json",
  "title": "ZKP Proof Schema",
  "description": "Schema voor Zero-Knowledge Proof data die gedeeld wordt tussen meter en display",
  "type": "object",
  "required": ["version", "proofType", "proof"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema versie"
    },
    "proofType": {
      "type": "string",
      "enum": ["groth16", "schnorr"],
      "description": "Type ZKP bewijs"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Tijdstip van proof generatie"
    },
    "proof": {
      "oneOf": [
        { "$ref": "#/$defs/groth16Proof" },
        { "$ref": "#/$defs/schnorrProof" }
      ]
    },
    "publicInputs": {
      "type": "object",
      "description": "Publieke inputs voor verificatie",
      "properties": {
        "publicSquare": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Publieke kwadraat waarde (voor groth16)"
        },
        "y": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Publieke sleutel y = g^x mod p (voor schnorr)"
        }
      }
    },
    "verified": {
      "type": "boolean",
      "description": "Of de proof geverifieerd is"
    }
  },
  "$defs": {
    "groth16Proof": {
      "type": "object",
      "title": "Groth16 ZK-SNARK Proof",
      "required": ["pi_a", "pi_b", "pi_c", "protocol"],
      "properties": {
        "protocol": {
          "type": "string",
          "const": "groth16"
        },
        "pi_a": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 3,
          "maxItems": 3,
          "description": "Proof element A (G1 punt)"
        },
        "pi_b": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Proof element B (G2 punt)"
        },
        "pi_c": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 3,
          "maxItems": 3,
          "description": "Proof element C (G1 punt)"
        },
        "curve": {
          "type": "string",
          "default": "bn128",
          "description": "Elliptische curve gebruikt"
        }
      }
    },
    "schnorrProof": {
      "type": "object",
      "title": "Schnorr Sigma Protocol Proof",
      "description": "Volledig Schnorr identificatie protocol transcript",
      "required": ["t", "c", "s", "params", "transcript"],
      "properties": {
        "protocol": {
          "type": "string",
          "const": "schnorr",
          "description": "Protocol identifier"
        },
        "params": {
          "type": "object",
          "title": "Groep Parameters",
          "description": "Cryptografische groep parameters voor het Schnorr protocol",
          "required": ["p", "q", "g"],
          "properties": {
            "p": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "description": "Prime modulus (veilige prime)"
            },
            "q": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "description": "Subgroup orde (q deelt p-1)"
            },
            "g": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "description": "Generator van de subgroep met orde q"
            },
            "securityLevel": {
              "type": "integer",
              "minimum": 1,
              "description": "Beveiligingsniveau in bits (bijv. 128, 256)"
            }
          }
        },
        "transcript": {
          "type": "object",
          "title": "Protocol Transcript",
          "description": "Volledig transcript van het 3-move sigma protocol",
          "required": ["commitment", "challenge", "response"],
          "properties": {
            "commitment": {
              "type": "object",
              "description": "Stap 1: Prover commitment",
              "required": ["t"],
              "properties": {
                "r": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "description": "Random nonce r ∈ Zq (normaal geheim, hier voor educatie)"
                },
                "t": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "description": "Commitment t = g^r mod p"
                }
              }
            },
            "challenge": {
              "type": "object",
              "description": "Stap 2: Verifier challenge",
              "required": ["c"],
              "properties": {
                "c": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "description": "Random challenge c ∈ Zq"
                },
                "source": {
                  "type": "string",
                  "enum": ["interactive", "fiat-shamir"],
                  "description": "Hoe de challenge is gegenereerd"
                }
              }
            },
            "response": {
              "type": "object",
              "description": "Stap 3: Prover response",
              "required": ["s"],
              "properties": {
                "s": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "description": "Response s = (r + c·x) mod q"
                }
              }
            }
          }
        },
        "t": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Commitment t = g^r mod p (shorthand)"
        },
        "c": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Challenge c (shorthand)"
        },
        "s": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Response s = (r + c·x) mod q (shorthand)"
        },
        "verification": {
          "type": "object",
          "title": "Verificatie Resultaat",
          "description": "Verificatie berekeningen en resultaat",
          "properties": {
            "lhs": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "description": "Linkerkant: g^s mod p"
            },
            "rhs": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "description": "Rechterkant: t · y^c mod p"
            },
            "equation": {
              "type": "string",
              "const": "g^s ≡ t · y^c (mod p)",
              "description": "Verificatie vergelijking"
            },
            "valid": {
              "type": "boolean",
              "description": "Of lhs === rhs"
            }
          }
        }
      }
    }
  }
}
